# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Web static files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.svg text eol=lf

# Python & config files
*.py text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pyd binary
*.dll binary
*.so binary
*.dylib binary
*.xlsx binary
