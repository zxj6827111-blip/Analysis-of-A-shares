# 示例环境变量（install 脚本会生成 deploy/astock.env）
# 复制: cp deploy/astock.env.example deploy/astock.env

ASTOCK_APP_ROOT=/opt/wtpy/wtpy-master
ASTOCK_HOST=127.0.0.1
ASTOCK_PORT=8765
ASTOCK_STORAGE=/opt/wtpy/wtpy-master/storage/astock
# 服务器上有通达信 vipdoc 时再填，否则可留空
# ASTOCK_TDX_ROOT=/data/tdx

# Tushare API Token，必配（不配置则 tushare 数据同步/因子同步会失败）
# 获取方式: https://tushare.pro 个人主页
TUSHARE_TOKEN=

# ---- overlay_v1 增量存储（推荐）----
# 置为 overlay_v1 后:
#   - 每周五 EOD 走 --write-mode delta:仅把更新窗口的变更行写入 DuckDB
#     (delta/market_delta*.duckdb),不再周期性重写完整行情 NPZ
#   - 正式 L1/L2 变为虚拟视图(基准 blob + 增量合并/运行时 QFQ)
#   - 60 个真实交易日或 Delta 达到 512MB 时自动生成新基准
#   - 仅保留当前代 + 上一代，退休代宽限 7 天；pin/运行中任务受保护
#   - 回滚:清空该值后重启服务即可回到旧完整快照模式
# 启用前需先运行: python scripts/migrate_market_data_overlay.py --apply
ASTOCK_MARKET_STORAGE_MODE=overlay_v1

# 服务器时区（北京时间）
TZ=Asia/Shanghai

# 每周五 18:30 行情更新，成功后自动执行 consolidation/retention/Blob GC
ASTOCK_EOD_SYNC_ENABLED=1
ASTOCK_EOD_SYNC_STARTUP=1
ASTOCK_EOD_SYNC_TIME=18:30
ASTOCK_EOD_SYNC_WEEKDAY=4
ASTOCK_EOD_SYNC_INDEX_ETF=0
ASTOCK_EOD_SYNC_MIN_LAG_DAYS=1
ASTOCK_EOD_SYNC_POLL_SECONDS=300
ASTOCK_EOD_SYNC_MAX_RETRIES=2

# 本地磁盘长期治理（不依赖 NAS）
ASTOCK_MARKET_GOVERNANCE_ENABLED=1
ASTOCK_RETENTION_GENERATIONS=2
ASTOCK_RETENTION_GRACE_DAYS=7
# Legacy materialized snapshots: wait 14 days and keep one complete fallback per family.
ASTOCK_LEGACY_RETENTION_ENABLED=1
ASTOCK_LEGACY_KEEP_PER_FAMILY=1
ASTOCK_LEGACY_MIGRATION_GRACE_DAYS=14
ASTOCK_LEGACY_MANIFEST_MIN_AGE_DAYS=7
ASTOCK_CONSOLIDATE_TRADING_DAYS=60
ASTOCK_CONSOLIDATE_DELTA_BYTES=536870912
ASTOCK_CONSOLIDATE_MIN_FREE_GB=5
ASTOCK_CONSOLIDATE_MAX_DISK_USAGE_PCT=80

# CA 公司行为安排在同一周五的行情更新之后
ASTOCK_CA_SYNC_WEEKDAY=4
ASTOCK_CA_SYNC_TIME=23:00
