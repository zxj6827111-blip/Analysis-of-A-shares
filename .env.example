# AStock 本机配置模板 - 复制为 .env 并按本机修改。.env 不入 Git。
# 部署环境: production | development | test
ASTOCK_ENV=production
# 正式行情数据根(必须显式设置; production 下缺失将拒绝启动)
MARKET_DATA_ROOT=E:\AStockData\datasets\market_data
# 日线正式存储使用稳定基准 blob + DuckDB 增量，避免重写全历史。
ASTOCK_MARKET_STORAGE_MODE=overlay_v1
# 指数/ETF 仍是传统 blob 路径，默认关闭例行更新以控制增长。
ASTOCK_EOD_SYNC_INDEX_ETF=0
# 供应商原始日K ZIP 根目录(--source local_vendor 使用)
LOCAL_VENDOR_RAW_ROOT=E:\AStockData\raw\local_vendor\original_files\incoming
# 可选: 仅调试用 - 允许 production 使用内部测试数据根(强烈不建议)
# ASTOCK_ALLOW_INTERNAL_DATA_ROOT=1
# Tushare adj_factor 原始CSV缓存根
TUSHARE_FACTOR_RAW_ROOT=E:\AStockData\factors\tushare\adj_factor
# Tushare token（自动更新/手动同步均使用；也支持 tushare 包 set_token 配置）
# TUSHARE_TOKEN=你的token
#
# -- 每周行情更新（默认开启）--
# 仅在每周五（weekday=4）到达 ASTOCK_EOD_SYNC_TIME 后执行周增量同步。
# 同步成功后自动执行 consolidation、双代保留和 Blob GC。
# ASTOCK_EOD_SYNC_ENABLED=1
# ASTOCK_EOD_SYNC_STARTUP=1
# ASTOCK_EOD_SYNC_TIME=18:30
# ASTOCK_EOD_SYNC_WEEKDAY=4
# ASTOCK_EOD_SYNC_MIN_LAG_DAYS=1
# ASTOCK_EOD_SYNC_POLL_SECONDS=300
# 失败当天最多自动重试次数（0 = 不重试；每次间隔 POLL_SECONDS）
# ASTOCK_EOD_SYNC_MAX_RETRIES=2
#
# -- 本地长期数据治理 --
# ASTOCK_MARKET_GOVERNANCE_ENABLED=1
# ASTOCK_RETENTION_GENERATIONS=2
# ASTOCK_RETENTION_GRACE_DAYS=7
# Legacy full snapshots are governed after 14 days; keep one complete fallback per family.
# ASTOCK_LEGACY_RETENTION_ENABLED=1
# ASTOCK_LEGACY_KEEP_PER_FAMILY=1
# ASTOCK_LEGACY_MIGRATION_GRACE_DAYS=14
# ASTOCK_LEGACY_MANIFEST_MIN_AGE_DAYS=7
# ASTOCK_CONSOLIDATE_TRADING_DAYS=60
# ASTOCK_CONSOLIDATE_DELTA_BYTES=536870912
# ASTOCK_CONSOLIDATE_MIN_FREE_GB=5
# ASTOCK_CONSOLIDATE_MAX_DISK_USAGE_PCT=80
#
# -- CA 公司行为每周更新 --
# 与行情一样仅在周五执行，默认安排在行情同步之后。
# ASTOCK_CA_SYNC_WEEKDAY=4
# ASTOCK_CA_SYNC_TIME=23:00
